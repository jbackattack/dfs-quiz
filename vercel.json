{
  "version": 2,
  "outputDirectory": "frontend",
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/quiz-backend.js" },
    { "src": "/health", "dest": "backend/quiz-backend.js" },
    { "src": "/(.*)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/quiz-with-timer.html" }
  ],
  "env": { "NODE_ENV": "production" },
  "regions": ["iad1"]
}